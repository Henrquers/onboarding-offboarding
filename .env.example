# Conexão do Postgres. Na Vercel, cole aqui a connection string do Neon ou do
# Supabase (a versão "pooled"/pgbouncer).
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave usada para assinar o cookie de sessão. Gere uma com:
#   openssl rand -base64 32
AUTH_SECRET=""

# Opcional: senha inicial dos usuários criados pelo seed. Se ficar em branco,
# o script sorteia uma e imprime no terminal.
SENHA_INICIAL=""
