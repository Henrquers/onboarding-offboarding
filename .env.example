# Conexão do Postgres. Na Vercel, cole aqui a connection string do Neon
# (a versão "pooled"/pgbouncer).
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Chave usada para assinar o cookie de sessão. Gere uma com:
#   openssl rand -base64 32
AUTH_SECRET=""

# Primeiro acesso, criado automaticamente na publicação enquanto não houver
# ninguém cadastrado. Depois de entrar e trocar a senha, estas três podem ser
# apagadas: o app nunca sobrescreve o acesso de quem já existe.
ADMIN_NOME=""
ADMIN_EMAIL=""
ADMIN_SENHA=""
